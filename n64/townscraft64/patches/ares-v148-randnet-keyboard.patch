index 27022727..13cca10d 100644
--- a/desktop-ui/emulator/nintendo-64.cpp
+++ b/desktop-ui/emulator/nintendo-64.cpp
@@ -6,6 +6,7 @@ struct Nintendo64 : Emulator {
