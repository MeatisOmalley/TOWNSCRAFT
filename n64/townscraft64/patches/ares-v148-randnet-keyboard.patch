   std::shared_ptr<mia::Pak> disk;
   u32 regionID = 0;
@@ -136,6 +137,14 @@ auto Nintendo64::load() -> LoadResult {
 
   for(auto id : range(controllers)) {
     if(auto port = root->find<ares::Node::Port>({"Controller Port ", 1 + id})) {
+      string device = settings.nintendo64.controllerPort[id];
+      if(device == "Mouse" || device == "Randnet Keyboard") {
+        port->allocate(device);
+        port->connect();
+        //the Randnet keyboard reads the host keyboard only while it is captured
+        if(device == "Randnet Keyboard") program.keyboardCaptured = true;
+        continue;
+      }
       auto peripheral = port->allocate("Gamepad");
       port->connect();
       bool transferPakConnected = false;
@@ -409,3 +418,42 @@ auto Nintendo64::pak(ares::Node::Object node) -> std::shared_ptr<vfs::directory>
   if(node->name() == "Gamepad") return gamepad->pak;
   return {};
 }
+
+//Randnet Keyboard keys follow host keys by position: a JIS host keyboard maps
+//one to one; on a US keyboard the keys it lacks use spare keys instead.
+auto Nintendo64::input(ares::Node::Input::Input input) -> void {
+  auto device = ares::Node::parent(input);
+  if(!device) return;
+
+  if(device->name() != "Randnet Keyboard") return Emulator::input(input);
+
+  if(!program.keyboardCaptured) return;
+  auto button = input->cast<ares::Node::Input::Button>();
+  if(!button) return;
+
+  static const struct { const char* name; const char* host[2]; } hostKeys[] = {
+    {"Num Lock", {"PrintScreen"}}, {"Below Num Lock LED", {"ScrollLock"}},
+    {"Below Caps Lock LED", {"PageUp"}}, {"Below Power LED", {"PageDown"}},
+    {"Hankaku/Zenkaku", {"Tilde"}},
+    {"1", {"Num1"}}, {"2", {"Num2"}}, {"3", {"Num3"}}, {"4", {"Num4"}}, {"5", {"Num5"}},
+    {"6", {"Num6"}}, {"7", {"Num7"}}, {"8", {"Num8"}}, {"9", {"Num9"}}, {"0", {"Num0"}},
+    {"-", {"Dash"}}, {"^", {"Equal"}},
+    {"'", {"LeftBracket"}}, {"{", {"RightBracket"}}, {"}", {"Backslash"}},
+    {"Caps Lock", {"CapsLock"}}, {"+", {"Semicolon"}}, {"*", {"Apostrophe"}},
+    {"Enter", {"Return", "Enter"}},
+    {"Left Shift", {"LeftShift"}}, {"<", {"Comma"}}, {">", {"Period"}}, {"?", {"Slash"}},
+    {"Long Dash", {"Ro", "RightControl"}}, {"Right Shift", {"RightShift"}},
+    {"Ctrl", {"LeftControl"}}, {"Opt", {"LeftSuper"}}, {"|", {"Yen", "Delete"}},
+    {"Alt", {"LeftAlt"}}, {"Eisu", {"Muhenkan", "Insert"}}, {"Space", {"Spacebar"}},
+    {"Kana", {"Henkan", "RightAlt"}}, {"Japanese Character", {"Katakana", "RightSuper"}},
+  };
+
+  for(auto& keys : hostKeys) {
+    if(input->name() != keys.name) continue;
+    bool pressed = false;
+    for(auto key : keys.host) if(key) pressed |= inputKeyboard(key);
+    return button->setValue(pressed);
+  }
+  //letters, F-keys, Escape, Tab, Backspace, Home, End and arrows share their host names
+  button->setValue(inputKeyboard(input->name()));
+}
