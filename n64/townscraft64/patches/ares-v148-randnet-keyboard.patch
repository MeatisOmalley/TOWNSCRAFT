diff --git a/ares/n64/controller/randnet-keyboard/randnet-keyboard.cpp b/ares/n64/controller/randnet-keyboard/randnet-keyboard.cpp
new file mode 100644
index 00000000..32c85a25
--- /dev/null
+++ b/ares/n64/controller/randnet-keyboard/randnet-keyboard.cpp
@@ -0,0 +1,115 @@
+//Randnet Keyboard protocol, as far as it is documented:
+//  fraser125, "Randnet Keyboard", Console Protocols (bus captures of a real
+//    RND-001 on a 64DD running the Randnet disk): identifier 00 02 00, command
+//    0x13 with one LED byte (bit 0 Num Lock, 1 Caps Lock, 2 Power), 7-byte
+//    reply of three 16-bit matrix positions and a status byte (bit 0 Home,
+//    bit 4 "too many keys": a fourth key clears all key slots), no reply to 0x01.
+//  N64brew wiki "Keyboard": the same matrix positions.
+//  usb64 and the MiSTer N64 core: device-side reimplementations.
+//Not verified against hardware here: the order of keys within the three slots
+//(this keeps press order and closes gaps on release, as MiSTer does), whether
+//Home counts toward the three-key limit (it does not here), whether 0xFF
+//resets the LEDs (it does not here), and replies to short or unknown commands
+//(none here).
+
+RandnetKeyboard::RandnetKeyboard(Node::Port parent) {
+  node = parent->append<Node::Peripheral>("Randnet Keyboard");
+  portName = parent->name();
+
+  //key names follow the Console Protocols key table (rows top to bottom, left to right)
+  static const struct { const char* name; u16 matrix; } layout[] = {
+    {"Escape", 0x0a08}, {"F1", 0x0b01}, {"F2", 0x0a01}, {"F3", 0x0b08}, {"F4", 0x0a07},
+    {"F5", 0x0b07}, {"F6", 0x0a02}, {"F7", 0x0b02}, {"F8", 0x0a03}, {"F9", 0x0b03},
+    {"F10", 0x0a04}, {"F11", 0x0203}, {"F12", 0x0b06}, {"Num Lock", 0x0a05},
+    {"Below Num Lock LED", 0x0b05}, {"Below Caps Lock LED", 0x0208}, {"Below Power LED", 0x0207},
+
+    {"Hankaku/Zenkaku", 0x0d05}, {"1", 0x0c05}, {"2", 0x0505}, {"3", 0x0605}, {"4", 0x0705},
+    {"5", 0x0805}, {"6", 0x0905}, {"7", 0x0906}, {"8", 0x0806}, {"9", 0x0706}, {"0", 0x0606},
+    {"-", 0x0506}, {"^", 0x0c06}, {"Backspace", 0x0d06},
+
+    {"Tab", 0x0d01}, {"Q", 0x0c01}, {"W", 0x0501}, {"E", 0x0601}, {"R", 0x0701}, {"T", 0x0801},
+    {"Y", 0x0901}, {"U", 0x0904}, {"I", 0x0804}, {"O", 0x0704}, {"P", 0x0604}, {"'", 0x0504},
+    {"{", 0x0c04}, {"}", 0x0406},
+
+    {"Caps Lock", 0x0f05}, {"A", 0x0d07}, {"S", 0x0c07}, {"D", 0x0507}, {"F", 0x0607},
+    {"G", 0x0707}, {"H", 0x0807}, {"J", 0x0907}, {"K", 0x0903}, {"L", 0x0803}, {"+", 0x0703},
+    {"*", 0x0603}, {"Enter", 0x0d04},
+
+    {"Left Shift", 0x0e01}, {"Z", 0x0d08}, {"X", 0x0c08}, {"C", 0x0508}, {"V", 0x0608},
+    {"B", 0x0708}, {"N", 0x0808}, {"M", 0x0908}, {"<", 0x0902}, {">", 0x0802}, {"?", 0x0702},
+    {"Long Dash", 0x1004}, {"Up", 0x0204}, {"Right Shift", 0x0e06},
+
+    {"Ctrl", 0x1107}, {"Opt", 0x0f07}, {"|", 0x1105}, {"Alt", 0x1008}, {"Eisu", 0x1002},
+    {"Space", 0x0602}, {"Kana", 0x0e02}, {"Japanese Character", 0x1006}, {"Home", 0x0000},
+    {"End", 0x0206}, {"Left", 0x0205}, {"Down", 0x0305}, {"Right", 0x0405},
+  };
+  for(auto& key : layout) {
+    keys.push_back({node->append<Node::Input::Button>(key.name), key.matrix});
+  }
+
+  leds = 0;
+  home = 0;
+}
+
+RandnetKeyboard::~RandnetKeyboard() {
+}
+
+auto RandnetKeyboard::comm(n8 send, n8 recv, n8 input[], n8 output[]) -> n2 {
+  b1 valid = 0;
+  b1 over = 0;
+
+  //status
+  if(input[0] == 0x00 || input[0] == 0xff) {
+    output[0] = 0x00;  //0x0002 = Randnet keyboard
+    output[1] = 0x02;
+    output[2] = 0x00;
+    valid = 1;
+  }
+
+  //read keypress; the second byte sets the LEDs
+  if(input[0] == 0x13 && send >= 2) {
+    setLeds(input[1]);
+    poll();
+    n8 status = 0;
+    status.bit(0) = home;
+    for(u32 slot : range(3)) {
+      u16 matrix = held.size() <= 3 && slot < held.size() ? held[slot] : 0;
+      output[slot * 2 + 0] = matrix >> 8;
+      output[slot * 2 + 1] = matrix >> 0;
+    }
+    if(held.size() > 3) status.bit(4) = 1;
+    output[6] = status;
+    over = recv > 7;
+    valid = 1;
+  }
+
+  n2 result = 0;
+  result.bit(0) = valid;
+  result.bit(1) = over;
+  return result;
+}
+
+auto RandnetKeyboard::poll() -> void {
+  for(auto& key : keys) {
+    platform->input(key.button);
+    bool pressed = key.button->value();
+    if(!key.matrix) { home = pressed; continue; }
+    auto position = std::find(held.begin(), held.end(), key.matrix);
+    if(pressed && position == held.end()) held.push_back(key.matrix);
+    if(!pressed && position != held.end()) held.erase(position);
+  }
+}
+
+auto RandnetKeyboard::setLeds(n8 data) -> void {
+  if(data == leds) return;
+  leds = data;
+  string message{
+    portName, " keyboard LEDs: Power ", leds.bit(2) ? "on" : "off",
+    ", Caps Lock ", leds.bit(1) ? "on" : "off", ", Num Lock ", leds.bit(0) ? "on" : "off"
+  };
+  platform->status(message);
+}
+
+auto RandnetKeyboard::serialize(serializer& s) -> void {
+  s(leds);
+}
diff --git a/ares/n64/controller/randnet-keyboard/randnet-keyboard.hpp b/ares/n64/controller/randnet-keyboard/randnet-keyboard.hpp
new file mode 100644
index 00000000..bcc75f57
--- /dev/null
+++ b/ares/n64/controller/randnet-keyboard/randnet-keyboard.hpp
@@ -0,0 +1,23 @@
+//Randnet Keyboard (RND-001): the Japanese 64DD keyboard used by the Randnet disk.
+//Joybus identifier 0x0002; command 0x13 sends one LED byte and returns three
+//2-byte key matrix positions plus a status byte. See randnet-keyboard.cpp for
+//sources and the details that are not verified against hardware.
+struct RandnetKeyboard : Controller {
+  struct Key {
+    Node::Input::Button button;
+    u16 matrix;  //0x0000 = reported in the status byte instead (Home)
+  };
+  std::vector<Key> keys;
+  std::vector<u16> held;  //matrix positions in press order
+  string portName;
+  n8 leds;
+  b1 home;
+
+  RandnetKeyboard(Node::Port);
+  ~RandnetKeyboard();
+
+  auto comm(n8 send, n8 recv, n8 input[], n8 output[]) -> n2 override;
+  auto poll() -> void;
+  auto setLeds(n8 data) -> void;
+  auto serialize(serializer&) -> void override;
+};
