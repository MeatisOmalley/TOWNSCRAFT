+/* DOScraft test harness, off unless DOSCRAFT_KEY_FILE names a file. Every
+   50 emulated milliseconds the file is polled; when present it is read and
+   deleted, and its whitespace-separated tokens are queued: a hex AT set-1
+   scan code (E0xx for extended keys) is pressed for 40 ms, then released
+   40 ms later; "wN" waits N ms. This configures a fresh BIOS CMOS without
+   host keyboard focus. It feeds the same path as host key events. */
+static void
+doscraft_key_file(void)
+{
+    static const char *path;
+    static int         checked;
+    static uint32_t    queue[512];
+    static int         head, tail;
+    static uint64_t    now, next;
+    static uint16_t    held;
+
+    if (!checked) {
+        checked = 1;
+        path    = getenv("DOSCRAFT_KEY_FILE");
+    }
+    if (path == NULL)
+        return;
+    ++now;
+    if (held && now >= next - 40) {
+        keyboard_input(0, held);
+        held = 0;
+    }
+    if ((now % 50) == 0 && head == tail) {
+        FILE *fp = fopen(path, "rb");
+        if (fp != NULL) {
+            char token[32];
+            while (fscanf(fp, "%31s", token) == 1 && ((tail + 1) & 511) != head) {
+                queue[tail] = (token[0] == 'w') ? (0x80000000u | (uint32_t) strtoul(token + 1, NULL, 10))
+                                                : (uint32_t) strtoul(token, NULL, 16);
+                tail = (tail + 1) & 511;
+            }
+            fclose(fp);
+            remove(path);
+        }
+    }
+    if (now < next || head == tail || held)
+        return;
+    if (queue[head] & 0x80000000u)
+        next = now + (queue[head] & 0x7fffffffu);
+    else {
+        held = (uint16_t) queue[head];
+        keyboard_input(1, held);
+        next = now + 80;
+    }
+    head = (head + 1) & 511;
+}
+
 void
 pc_run(void)
 {
@@ -2028,6 +2080,7 @@ pc_run(void)
 
     /* Done with this frame, update statistics. */
     framecount++;
+    doscraft_key_file();
     if (++framecountx >= (force_10ms ? 100 : 1000)) {
         framecountx = 0;
         frames      = 0;
